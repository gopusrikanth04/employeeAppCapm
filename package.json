{
  "name": "employeeApp",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/audit-logging": ">=0",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "mbt build",
    "deploy": "cf deploy mta_archives/employeeApp_1.0.0.mtar -f",
    "lint": "cds lint .",
    "eslint:sonar": "eslint . --ext .cds,.csn,.csv,.js -f json -o reports/eslint-report.json || true"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "connectivity": true,
        "destinations": true,
        "application-logging": true
      },
      "Northwind": {
        "kind": "rest",
        "[development]": {
          "credentials": {
            "url": "https://services.odata.org/V4/Northwind/Northwind.svc"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "Northwind",
            "path": "/"
          }
        }
      }
    }
  }
}
